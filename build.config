# Per-curriculum build settings, read by curriculum-build.sh/.bat on the host and
# by the builder image inside the container.
# `: "${KEY:=value}"` = use this unless already set in the environment.

# This repository renders TWO AsciiDoc roots from docs/ (names without .adoc).
# The builder image renders exactly one root per run, so the wrapper scripts loop
# over this list and set CURRICULUM_FILE for each container run.
# Override with `CURRICULUM_FILE=<one-root> ./curriculum-build.sh` to build just one.
: "${CURRICULUM_FILES:=examination-regulations examination-criteria}"

# Space-separated languages to build.
: "${LANGUAGES:=DE EN}"

# Space-separated extra variants, exposed as the {suffix} attribute. Empty = single build.
: "${SUFFIX_TAGS:=}"

# PDF print/book layout (recto chapter starts + binding margins). true | false.
: "${PREPRESS:=false}"

# Optional curriculum validity date, format YYYY/MM/DD (e.g. 2025/04/01).
# When set, appended to {document-version} as " (valid from April 1, 2025)" /
# " (Gültig ab 1. April 2025)" per language. Invalid format is ignored.
# : "${VALID_FROM:=2025/04/01}"
